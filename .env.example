# ==============================================================================
# Library Management System - Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# ==============================================================================

# Security & Tokens
SECRET_KEY=library-management-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Administrator Bootstrap Credentials (Used only on initial database initialization)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@library.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=System Administrator

# Database Connection (Default is SQLite, can be postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./library.db

# Library Circulation & Business Policies
DEFAULT_LOAN_DAYS=14
MAX_RENEWALS=2
RENEWAL_DAYS=14
FINE_PER_DAY=10.0
GRACE_PERIOD_DAYS=1
RESERVATION_EXPIRY_DAYS=3
MAX_ACTIVE_RESERVATIONS=3
MAX_UNPAID_FINE_LIMIT=100.0
